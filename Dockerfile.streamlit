# AgentAudit dashboard -- separate deploy target from the API. Split into
# its own container because Streamlit and FastAPI have different process
# models (Streamlit wants to own the main thread) and you usually want to
# scale/restart them independently.
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8501
CMD ["streamlit", "run", "frontend/app_streamlit.py", "--server.port=8501", "--server.address=0.0.0.0"]
